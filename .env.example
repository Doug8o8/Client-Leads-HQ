# =====================================================================
# Client Leads HQ — environment variables
# =====================================================================
# The app runs in TWO modes:
#
#   • Local Demo Mode  — NO variables set. Everything persists in the
#                        browser via localStorage. This is the default and
#                        requires zero setup. Great for local development.
#
#   • Supabase Mode    — the two NEXT_PUBLIC_* vars below are set. Enables
#                        auth pages and (in Phase 3B) cloud persistence.
#
# Copy this file to `.env.local` and fill in values to enable Supabase Mode.
# Leaving it empty keeps the app in Local Demo Mode — nothing breaks.
# =====================================================================

# --- Required for SUPABASE MODE (safe to expose to the browser) -------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OPTIONAL: server-only scripts (seeding, admin tasks) -------------
# NEVER expose this to the client. It bypasses Row Level Security.
# Only needed if you run the seed/admin scripts in supabase/.
SUPABASE_SERVICE_ROLE_KEY=
